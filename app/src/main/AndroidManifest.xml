<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android shows the SSID of the Wi-Fi only to apps with the location permission. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- The app updates itself from the GitHub release or the test build of its channel. Without
         the user action permission Android asks to confirm every update, not only the first one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Frigate"
        android:supportsRtl="true"
        android:theme="@style/Theme.Frigate">
        <!-- The session of the app lives in the composition: the socket of the activity, the players
             of the cameras and the navigation of the archive. The activity handles the configuration
             changes itself, so a rotation keeps the camera or the archive the user has opened. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale|layoutDirection|locale"
            android:supportsPictureInPicture="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The system installer reports the result of an update here. -->
        <receiver
            android:name=".core.update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
