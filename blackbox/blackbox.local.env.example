# Локальные настройки BlackBox. Скопируйте в blackbox.local.env (он в .gitignore) и задайте значения.
# Файл должен иметь права 600. Значений по умолчанию нет: незаданный ключ останавливает запуск.
# Формат строго KEY=VALUE, без кавычек и подстановок. Переменные окружения перекрывают файл.

# mock — управляемый mock Frigate на этой машине; device — реальный сервер
BB_PROFILE=<mock|device>

# Устройство или эмулятор для adb -s
BB_DEVICE_SERIAL=<serial>

# application id blackbox-сборки; обязан оканчиваться на .blackbox (данные основного приложения не трогаются)
BB_APP_ID=<id приложения с суффиксом .blackbox>

# Путь к APK blackbox-сборки (./gradlew assembleBlackbox)
BB_APK=<путь к app-blackbox.apk>

# Тестовые учётные данные (для mock — любые, для device — тестовый аккаунт)
BB_USERNAME=<логин>
BB_PASSWORD=<пароль>

# Только для BB_PROFILE=mock: где слушает mock и какой адрес видит приложение через adb reverse.
# Хост должен быть из разрешённых debug-конфигом для cleartext (loopback-имя).
BB_MOCK_HOST=<хост>
BB_MOCK_PORT=<порт>

# Только для BB_PROFILE=device: адрес реального Frigate
BB_SERVER_URL=<url>

# Необязательно: Python с PyAV и numpy (venv). Без него mock не отдаёт видео, тесты кадра пропускаются.
BB_MEDIA_PYTHON=<путь к python>
